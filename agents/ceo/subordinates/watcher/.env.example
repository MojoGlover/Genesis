# Accountant is a live agent (Botico/agents/accountant). Watcher calls her
# Tool Bus endpoint (/api/tools/execute, tool "ledger_budget") per watched
# agent_id. Local default assumes she's running on this host; use her
# Tailscale address for a remote plug.
ACCOUNTANT_URL=http://localhost:5002
ACCOUNTANT_WATCHED_AGENTS=engineer0,accountant

# Manual override: skip the live Accountant call entirely and read a flat
# JSON metric snapshot instead ({"engineer0_spend_usd": 12.5, ...}). Useful
# offline or if Accountant's model_gateway backend (port 9109) is down —
# unset means "use the live call."
ACCOUNTANT_LEDGER_PATH=

# Chronicle ingest (plugfoe Tailscale, port 5010). Leave CHRONICLE_INGEST_KEY
# unset to log locally only — matches PlugOps' own feature-gate behavior.
CHRONICLE_URL=http://100.67.171.41:5010
CHRONICLE_INGEST_KEY=

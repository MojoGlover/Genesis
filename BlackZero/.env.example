# BlackZero agent environment configuration
# Copy to .env and fill in values. Never commit .env to source control.
# stamp.py does not rewrite this file — fill it in per agent.

# ── Ollama (local: leave default; Docker: set to sidecar container hostname) ─
OLLAMA_API_URL=http://localhost:11434/api

# ── PlugOps bus (leave PLUGOPS_URL empty to use config.yaml plugops.url) ────
PLUGOPS_URL=
PLUGOPS_AGENT=

# ── Storage (Docker: set to /data and mount a volume) ───────────────────────
DATA_DIR=

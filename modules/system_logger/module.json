{
  "name": "system-logger",
  "version": "1.0.0",
  "description": "Centralized structured logging for all PlugOps agents — errors, warnings, events.",
  "author": "Computer Black",
  "tags": ["logging", "errors", "monitoring", "agents"],
  "enabled": true,
  "routes": [
    "POST /logs/ingest",
    "POST /logs/ingest/batch",
    "GET  /logs",
    "GET  /logs/agents/{agent_id}",
    "GET  /logs/errors",
    "GET  /logs/summary",
    "GET  /logs/stats",
    "DELETE /logs/agents/{agent_id}",
    "DELETE /logs/all"
  ],
  "storage": "~/.plugops/system_logger.db",
  "config": {
    "max_rows_per_agent": 5000,
    "cache_size": 200
  }
}
